---
import BaseLayout from '../layouts/BaseLayout.astro';
import Carousel from '../components/Carousel.astro';

const screenshots = [
  {
    src: '/images/synthgarage/screenshots/1-find.png',
    alt: 'Synthgarage on Mac: a filtered list of Yamaha DX7 patches beside the selected patch\'s algorithm diagram and operator settings'
  },
  {
    src: '/images/synthgarage/screenshots/2-organise.png',
    alt: 'Synthgarage Organise view: the DX7 library alongside custom lists for a live show and favourite pads'
  },
  {
    src: '/images/synthgarage/screenshots/3-connect.png',
    alt: 'Synthgarage connection guide showing how to connect a Behringer Pro VS Mini to a Mac over USB-C'
  },
  {
    src: '/images/synthgarage/screenshots/4-convert.png',
    alt: 'Synthgarage conversion estimate: 88% of a UB-1 micro patch will carry across to a JT-4000'
  },
  {
    src: '/images/synthgarage/screenshots/5-randomise.png',
    alt: 'Synthgarage Randomise sheet generating variations of a patch that match chosen tags'
  }
];
---

<BaseLayout
  title="Synthgarage – Universal Preset Librarian"
  description="Universal preset librarian for your hardware synths. Available now on the Mac App Store; iPhone and iPad coming soon."
>
  <section class="hero hero-compact">
    <div class="hero-header-row">
      <h1>Synthgarage</h1>
      <span class="badge">iOS COMING SOON</span>
    </div>
    <p class="hero-subtitle">Universal Preset Librarian</p>
    <p class="platforms">Mac · iPhone · iPad</p>
    <p class="tagline">Real musicians use presets.</p>
    <p class="lead">
      Synthgarage is a universal preset librarian designed to help you organise, explore, and
      manage patches across your hardware synthesisers.
    </p>
    <a
      href="https://apps.apple.com/app/id6469452770?mt=12"
      style="display: inline-block;"
    >
      <img
        src="https://toolbox.marketingtools.apple.com/api/v2/badges/download-on-the-mac-app-store/black/en-us"
        alt="Download on the Mac App Store"
        style="width: 246px; height: 82px; vertical-align: middle; object-fit: contain;"
      />
    </a>
    <p class="platforms" style="margin-top: 0.75rem; font-size: 0.92rem;">
      <a href="/synthgarage-privacy" aria-label="View Synthgarage privacy policy">Privacy Policy</a>
      &middot;
      <a href="/synthgarage-terms" aria-label="View Synthgarage terms of service">Terms of Service</a>
    </p>
  </section>

  <section aria-label="Synthgarage screenshots">
    <Carousel screenshots={screenshots} width={1280} height={675} />
  </section>
</BaseLayout>
